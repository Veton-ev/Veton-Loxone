{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Veton guardrail kit (G6), PUBLIC-REPO variant — installed as <repo>/.claude/settings.json by kit/apply.sh --public. Same rules as the private variant except that remote-shell commands (ssh/scp/rsync/sftp/mosh) are denied as a whole family: a public integration repo has nothing to deploy, and a host-specific rule would publish the host. Rule syntax verified against code.claude.com/docs/en/permissions 2026-08-26: `*` matches any text, compound commands are split on && || ; | & and newlines and every subcommand is checked, deny beats allow at every scope, deny applies before workspace trust, allow only after. The PreToolUse hook (guard.sh) re-checks intent so re-phrasings are caught too; exit 2 blocks.",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push *:refs/heads/master)",
      "Bash(git push *:refs/heads/master *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/master)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)",
      "Bash(git branch -d main*)",
      "Bash(git branch -d master*)",
      "Bash(git branch --delete main*)",
      "Bash(git branch --delete master*)",
      "Bash(ssh *)",
      "Bash(ssh)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(sftp)",
      "Bash(mosh *)",
      "Bash(mosh)",
      "Bash(autossh *)",
      "Bash(docker -H * compose *)",
      "Bash(docker --host * compose *)",
      "Bash(docker --context * compose *)",
      "Bash(docker context use *)",
      "Bash(make deploy*)",
      "Bash(make * deploy*)",
      "Bash(make push-firmware*)",
      "Bash(make * push-firmware*)",
      "Bash(./deploy.sh*)",
      "Bash(deploy/deploy.sh*)",
      "Bash(./deploy/deploy.sh*)",
      "Bash(sh deploy.sh*)",
      "Bash(bash deploy.sh*)",
      "Bash(sh deploy/deploy.sh*)",
      "Bash(bash deploy/deploy.sh*)",
      "Bash(sh ./deploy.sh*)",
      "Bash(bash ./deploy.sh*)",
      "Bash(sh ./deploy/deploy.sh*)",
      "Bash(bash ./deploy/deploy.sh*)",
      "Bash(./scripts/canary-rollout.sh*)",
      "Bash(scripts/canary-rollout.sh*)",
      "Bash(bash *canary-rollout.sh*)",
      "Bash(sh *canary-rollout.sh*)",
      "Bash(./scripts/canary-deploy.sh*)",
      "Bash(scripts/canary-deploy.sh*)",
      "Bash(bash *canary-deploy.sh*)",
      "Bash(sh *canary-deploy.sh*)",
      "Bash(gh workflow run *)",
      "Bash(prisma migrate deploy*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(* npx prisma migrate deploy*)",
      "Bash(odoo-bin -u *)",
      "Bash(* odoo-bin -u *)",
      "Bash(odoo-bin * -u *)",
      "Bash(* odoo-bin * -u *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git blame *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m compileall *)",
      "Bash(python3 -m compileall *)",
      "Bash(ruff *)",
      "Bash(pyflakes *)",
      "Bash(make test *)",
      "Bash(make build *)",
      "Bash(make vet *)",
      "Bash(make lint *)",
      "Bash(make check *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart analyze *)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(gitleaks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
